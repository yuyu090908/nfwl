# Copy to .env (local) or set in the Vercel project settings. Never commit real values.

# PostgreSQL (Neon / Supabase / RDS ...). Local dev: postgresql://nfwl:nfwl@localhost:5432/nfwl?schema=public
DATABASE_URL=

# Public URL of the site (OAuth callbacks, SIWE domain). Extra allowed origins for the CSRF check, comma separated.
APP_URL=http://localhost:3000
APP_ORIGIN=

# Bearer secret for /api/cron/league (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=

# Optional social login. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Unity WebGL build location (folder that holds NFWL.loader.js etc.). Default: /unity/Build on this site.
NEXT_PUBLIC_UNITY_BUILD_URL=
NEXT_PUBLIC_UNITY_BUILD_NAME=NFWL
# "unityweb" (Brotli + decompression fallback, the NFWL/Build WebGL default), "br", "gz" or "none"
NEXT_PUBLIC_UNITY_COMPRESSION=unityweb

# Development only (ignored when NODE_ENV=production)
NFWL_ENABLE_BRIDGE_SIMULATOR=0
NFWL_ALLOW_SHORT_MATCHES=0
